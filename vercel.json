{
  "functions": {
    "api/export.js": { "maxDuration": 30 },
    "api/ressource.js": { "includeFiles": "public/gabarit.html", "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/ressource?vue=accueil" },
    { "source": "/ressource/:adresse", "destination": "/api/ressource?vue=page&adresse=:adresse" },
    { "source": "/sitemap.xml", "destination": "/api/ressource?vue=plan" },
    { "source": "/robots.txt", "destination": "/api/ressource?vue=robots" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
